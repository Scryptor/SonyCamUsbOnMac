<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <!-- Wi-Fi: камера в режиме PC Remote по сети (PTP/IP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- уровень сигнала Wi-Fi в подсказке о подключении; слежение за сетью Wi-Fi (пропала — провал, появилась — попытка) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- сокеты привязаны к сети Wi-Fi, даже если она не сеть по умолчанию (Wi-Fi Direct без интернета, сотовая связь) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Wi-Fi без энергосбережения на время сеанса (WifiLock WIFI_MODE_FULL_LOW_LATENCY) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Sony Cam Viewer"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZV">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- камера Sony подключена: Android предложит открыть программу и сразу даст доступ к USB -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
